<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)tmp/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)tmp/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseDalamudLibraries)' == 'true'">
    <BaseIntermediateOutputPath>$(BaseIntermediateOutputPath)dalamud/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BaseOutputPath)dalamud/</BaseOutputPath>
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">$(BaseIntermediateOutputPath)packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
