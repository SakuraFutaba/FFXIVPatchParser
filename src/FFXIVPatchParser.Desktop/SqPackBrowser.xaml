<UserControl x:Class="FFXIVPatchParser.Desktop.SqPackBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FFXIVPatchParser.Desktop"
             Loaded="BrowserLoaded" IsVisibleChanged="BrowserVisibilityChanged">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="PathTreeItemsPanel">
      <VirtualizingStackPanel/>
    </ItemsPanelTemplate>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource CompactPathTreeItem}">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="ItemsPanel" Value="{StaticResource PathTreeItemsPanel}"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="Padding" Value="4,3"/>
    </Style>
    <Style x:Key="PathTreeView" TargetType="TreeView" BasedOn="{StaticResource CompactPathTree}">
      <Setter Property="ItemsPanel" Value="{StaticResource PathTreeItemsPanel}"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="BorderBrush" Value="#E4E7EC"/>
    </Style>
    <Style x:Key="PatchScanSummary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="MaxHeight" Value="54"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <HierarchicalDataTemplate x:Key="PathTreeLabel" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate x:Key="PatchPathTreeLabel" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis">
        <TextBlock.ToolTip>
          <StackPanel MaxWidth="540">
            <TextBlock Text="{Binding FullPath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Payload.Evidence}" TextWrapping="Wrap" Margin="0,4,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </TextBlock.ToolTip>
      </TextBlock>
    </HierarchicalDataTemplate>
    <DrawingBrush x:Key="ImageBackground" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#F4F6F8" Geometry="M0,0 H16 V16 H0 Z"/>
          <GeometryDrawing Brush="#E3E7EC" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.IsSharedSizeScope="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FileTreeColumn" Width="0"/>
        <ColumnDefinition x:Name="FileDividerColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <local:SqPackFileTree x:Name="FileTree" Visibility="Collapsed"/>
      <GridSplitter x:Name="FileSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                    AutomationProperties.Name="调整文件目录宽度" Visibility="Collapsed"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition x:Name="FileDetailsRow" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="FileDetails" Visibility="Collapsed" Margin="0,0,0,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
              <Button x:Name="SwitchFilePreviewButton" Content="查看 Hex" Click="SwitchFilePreview" Visibility="Collapsed"/>
              <Button x:Name="JumpToFilePreviewButton" Click="JumpToFilePreview" Visibility="Collapsed"/>
              <Button x:Name="CopyFilePathButton" Style="{StaticResource CopyButton}" Content="复制路径" Click="CopyFilePath" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="FileSourcePath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="FileInfo" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock x:Name="FilePreviewIssue" Foreground="#9A3412" TextWrapping="Wrap"
                         Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid x:Name="FileHexPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="FileHexText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Padding="10,8" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="文件十六进制内容"/>
            <Border x:Name="FileHexNavigation" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8,0,14,0" Padding="6" CornerRadius="0,0,6,6" BorderThickness="1"
                    BorderBrush="{StaticResource Border}" Background="{StaticResource WorkspaceSurface}" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PreviousFileHexButton" Style="{StaticResource PreviousItemButton}" Margin="0,0,8,0" ToolTip="上一个字节区间" AutomationProperties.Name="上一个字节区间" Click="PreviousFileHex"/>
                <TextBox x:Name="FileOffsetInput" Width="116" Tag="十六进制偏移" KeyDown="FileOffsetKeyDown"
                         AutomationProperties.Name="十六进制偏移"/>
                <Button Content="跳转" Click="GoToFileOffset" Margin="6,0,0,0"/>
                <Button x:Name="NextFileHexButton" Style="{StaticResource NextItemButton}" ToolTip="下一个字节区间" AutomationProperties.Name="下一个字节区间"
                        Click="NextFileHex" Margin="6,0,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        <Grid x:Name="TablesPanel" IsEnabled="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TableTreeColumn" Width="196"/>
            <ColumnDefinition x:Name="TableTreeDivider" Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="TableTreePanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/></Grid.RowDefinitions>
            <TextBox x:Name="TableSearch" Style="{StaticResource SearchTextBox}" Tag="搜索表名…" ToolTip="搜索表名"
                     TextChanged="FilterTables" Margin="0,0,0,6"/>
            <TextBlock x:Name="TableCount" Grid.Row="2" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TreeView x:Name="TablesList" Grid.Row="1" Style="{StaticResource PathTreeView}" ItemTemplate="{StaticResource PathTreeLabel}"
                      SelectedItemChanged="TableSelected" PreviewMouseRightButtonDown="CopyLocalTableName" PreviewMouseLeftButtonDown="ClickLocalTable"/>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <ContentControl x:Name="InlineTableTabs" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <ScrollViewer x:Name="TableTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="LocalTableTabStrip" Orientation="Horizontal"/></ScrollViewer>
              </ContentControl>
              <ContentControl x:Name="InlineTableToolbar" HorizontalContentAlignment="Stretch" IsTabStop="False"/>
            </StackPanel>
            <ContentControl Grid.Row="2" x:Name="FooterTableToolbar" HorizontalContentAlignment="Stretch" IsTabStop="False">
              <DockPanel x:Name="TableToolbar" Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="TableModeButton" Content="切换至 Raw" Click="ToggleTableMode"/>
                  <Button Content="导入定义…" Click="ImportTableDefinitions" ToolTip="导入 SaintCoinach 定义目录"/>
                  <Button x:Name="ReloadRowsButton" Content="重新读取" Click="ReloadRows" IsEnabled="False"/>
                  <Button x:Name="ClearTableFiltersButton" Content="清除筛选" Click="ClearTableFilters" IsEnabled="False"/>
                  <Button x:Name="FitTableColumnsButton" Content="重置列宽" Click="ResetTableColumnSizing" IsEnabled="False" Margin="0"
                          ToolTip="按当前视图的表头和单元格最大宽度重置"/>
                </StackPanel>
                <TextBlock x:Name="TableInfo" Text="选择一张表查看完整内容" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </ContentControl>
            <Border x:Name="TableFrame" Grid.Row="1" Style="{StaticResource RoundedPreviewFrame}" Padding="0">
              <DataGrid x:Name="TableGrid" BorderThickness="0" SelectionUnit="Cell" CanUserSortColumns="False" IsVisibleChanged="TableGridVisibilityChanged"
                        RowBackground="{StaticResource WorkspaceSurface}" AlternatingRowBackground="#EAF0F8" AlternationCount="2"
                        RowHeaderWidth="0" RowHeaderStyle="{StaticResource HiddenTableRowHeader}"
                        CanUserReorderColumns="False" PreviewMouseLeftButtonUp="TableCellClicked" PreviewKeyDown="TableGridKeyDown"
                        ScrollViewer.ScrollChanged="TableGridScrolled" LostMouseCapture="TableGridLostMouseCapture"/>
            </Border>
            <ContentControl Grid.Row="3" x:Name="TableStatusHost" IsTabStop="False" VerticalAlignment="Top" HorizontalContentAlignment="Stretch"/>

          </Grid>
          <Popup x:Name="TableFilterPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Width="300">
              <StackPanel>
                <TextBlock x:Name="TableFilterTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="TableFilterInput" Style="{StaticResource SearchTextBox}" Tag="输入关键词，Enter 应用" KeyDown="TableFilterKeyDown"/>
                <TextBlock Text="在整张表中匹配原始值，多个列条件同时生效。" Foreground="{StaticResource Muted}" Margin="0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="应用" Click="ApplyTableFilter"/>
                  <Button Content="清除此列" Click="ClearTableFilter"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
          <Popup x:Name="CellPopup" Placement="Bottom" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="TableCellContent" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Width="500" PreviewKeyDown="CellPopupKeyDown">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="复制单元格" Click="CopyCell" Margin="8,0,0,0"/>
                  <TextBlock x:Name="CellTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <CheckBox x:Name="RawCellToggle" Content="显示原始值" Checked="ToggleRawCell" Unchecked="ToggleRawCell" Margin="0,0,0,6"/>
                <TextBox x:Name="CellText" IsReadOnly="True" MinHeight="42" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <Button x:Name="CellTargetIconButton" Visibility="Collapsed" Margin="0,8,0,0"
                        Style="{StaticResource CellIconLink}" Click="OpenCellIcon">
                  <local:NativePixelImage x:Name="CellTargetIcon" MaxWidth="352" MaxHeight="224"/>
                </Button>
                <TextBlock x:Name="CellRelationStatus" Visibility="Collapsed" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button x:Name="CellRelationButton" Visibility="Collapsed" Click="FollowCellRelation" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        <Grid x:Name="LocalImagesPanel" IsEnabled="False" Visibility="Collapsed" IsVisibleChanged="LocalImagesVisibilityChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ImageTreeColumn" Width="310"/>
            <ColumnDefinition x:Name="ImageTreeDivider" Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="LocalImageTreePanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="IconSearch" Style="{StaticResource SearchTextBox}" Tag="筛选路径或编号…" ToolTip="筛选图标路径或编号" TextChanged="FilterIcons" Margin="0,0,0,6"/>
            <TextBlock x:Name="TextureTreeCount" Grid.Row="2" Text="尚未读取目录" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <DockPanel Grid.Row="1">
            <Expander DockPanel.Dock="Top" x:Name="IconGallery" Header="目录缩略图" Margin="0,0,0,6"
                      Expanded="IconGalleryExpanded" Collapsed="IconGalleryCollapsed">
              <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="PreviousIconsButton" Style="{StaticResource PreviousItemButton}" Margin="0,0,8,0" ToolTip="上一页" AutomationProperties.Name="上一页" Click="PreviousIcons" IsEnabled="False"/>
                  <TextBlock x:Name="IconPageLabel" Text="选择一个目录" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button x:Name="NextIconsButton" Style="{StaticResource NextItemButton}" ToolTip="下一页" AutomationProperties.Name="下一页" Click="NextIcons" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="IconsList" Height="152" BorderBrush="#E4E7EC" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="IconSelected">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Width="84" Margin="1,3" ToolTip="{Binding Description}">
                        <Border Background="{StaticResource ImageBackground}" Width="56" Height="56" CornerRadius="3">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="1,4,1,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Expander>
            <TreeView x:Name="TextureTree" Style="{StaticResource PathTreeView}" ItemTemplate="{StaticResource PathTreeLabel}"
                      SelectedItemChanged="TextureTreeSelected"/>
            </DockPanel>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="LocalImagePathPanel" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="打开纹理" Click="OpenTexture" Margin="6,0,0,0"/>
              <TextBox x:Name="TexturePath" Tag="输入 SqPack 内的 .tex 或 .atex 路径…" ToolTip="SqPack 内的 .tex 或 .atex 路径"
                       KeyDown="TexturePathKeyDown"/>
            </DockPanel>
            <local:TexturePreview x:Name="LocalTexturePreview" Grid.Row="1"/>
          </Grid>
        </Grid>
    <local:IconBrowser x:Name="LocalIconBrowser" Visibility="Collapsed"/>
    <local:UldBrowser x:Name="LocalUldBrowser" Visibility="Collapsed"/>
    <local:ModelPreview x:Name="LocalModelsPanel" Visibility="Collapsed" RelatedTableRequested="OpenModelSheet"/>
    <local:MapPreview x:Name="LocalMapsPanel" Visibility="Collapsed" RelatedTableRequested="OpenModelSheet"/>
    <local:AudioPreview x:Name="LocalAudioPanel" Visibility="Collapsed"/>
    <Grid x:Name="PatchModelsPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/></Grid.RowDefinitions>
        <TextBox x:Name="PatchModelSearch" Style="{StaticResource SearchTextBox}" Tag="筛选模型路径…" Margin="0,0,0,6"
                 TextChanged="FilterPatchModels"/>
        <TextBlock x:Name="PatchModelsSummary" Grid.Row="2" Style="{StaticResource PatchScanSummary}" Margin="0,6,0,0"/>
        <TreeView x:Name="PatchModelsList" Grid.Row="1" Style="{StaticResource PathTreeView}" ItemTemplate="{StaticResource PathTreeLabel}"
                  SelectedItemChanged="PatchModelSelected"/>
      </Grid>
      <local:ModelPreview Grid.Column="2" x:Name="PatchModelPreview" ShowBrowser="False"/>
    </Grid>
    <Grid x:Name="PatchAudioPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/></Grid.RowDefinitions>
        <TextBox x:Name="PatchAudioSearch" Style="{StaticResource SearchTextBox}" Tag="筛选音频路径…" Margin="0,0,0,6"
                 TextChanged="FilterPatchAudio"/>
        <TextBlock x:Name="PatchAudioSummary" Grid.Row="2" Style="{StaticResource PatchScanSummary}" Margin="0,6,0,0"/>
        <TreeView x:Name="PatchAudioList" Grid.Row="1" Style="{StaticResource PathTreeView}" ItemTemplate="{StaticResource PathTreeLabel}"
                  SelectedItemChanged="PatchAudioSelected" PreviewMouseLeftButtonDown="PlayPatchAudioFile"/>
      </Grid>
      <local:AudioPreview Grid.Column="2" x:Name="PatchAudioPreview" ShowBrowser="False"/>
    </Grid>
    <Grid x:Name="PatchImagesPanel" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="310"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/></Grid.RowDefinitions>
          <TextBox x:Name="PatchImageSearch" Style="{StaticResource SearchTextBox}" Tag="筛选图片路径或变化依据…" ToolTip="筛选图片 Diff" Margin="0,0,0,6"
                   TextChanged="FilterPatchImages"/>
          <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="PatchImageCount" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="PatchSummary" Style="{StaticResource PatchScanSummary}"/>
          </StackPanel>
          <TreeView x:Name="PatchImagesList" Grid.Row="1" Style="{StaticResource PathTreeView}" ItemTemplate="{StaticResource PatchPathTreeLabel}"
                    SelectedItemChanged="PatchImageSelected"/>
        </Grid>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBox x:Name="PatchImagePath" IsReadOnly="True" Margin="0,0,0,6" Tag="选择一张图片查看纹理"/>
          <local:TexturePreview x:Name="PatchTexturePreview" Grid.Row="1"/>
        </Grid>
      </Grid>
    </Grid>
        </Grid>
      </Grid>
    </Grid>
    <ContentControl Grid.Row="1" x:Name="PageStatusHost" IsTabStop="False" HorizontalContentAlignment="Stretch">
    <DockPanel x:Name="BrowserStatusBar" Margin="0,6,0,0">
      <Button x:Name="CancelBrowserButton" DockPanel.Dock="Right" Content="取消" Click="CancelBrowser"
              Visibility="Collapsed" Padding="10,3" Margin="8,0,0,0"/>
      <ProgressBar x:Name="BrowserProgress" DockPanel.Dock="Right" Width="110" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="BrowserStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
    </ContentControl>
  </Grid>
</UserControl>
