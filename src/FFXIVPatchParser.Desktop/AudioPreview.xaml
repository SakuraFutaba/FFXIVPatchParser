<UserControl x:Class="FFXIVPatchParser.Desktop.AudioPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FFXIVPatchParser.Desktop"
 Loaded="PreviewLoaded" Unloaded="PreviewUnloaded" IsVisibleChanged="PreviewVisibilityChanged">
  <UserControl.Resources>
    <HierarchicalDataTemplate x:Key="AudioTreeLabel" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserColumn" Width="318"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="Browser" Margin="0,0,8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
      </Grid.RowDefinitions>
      <TextBox x:Name="AudioSearch" Style="{StaticResource SearchTextBox}" Tag="筛选音频路径…" Margin="0,0,0,6" TextChanged="FilterAudio"
               AutomationProperties.Name="筛选音频路径" ToolTip="筛选目录和文件名"/>
      <TextBlock x:Name="CatalogStatus" Grid.Row="2" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TreeView Grid.Row="1" x:Name="AudioTree" Style="{StaticResource CompactPathTree}" SelectedItemChanged="SelectAudio"
                PreviewMouseLeftButtonDown="PlayAudioFile" ItemTemplate="{StaticResource AudioTreeLabel}"/>
    </Grid>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
      </Grid.RowDefinitions>
      <DockPanel x:Name="PathInput" Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Content="打开 .scd" Click="OpenEnteredPath" Margin="6,0,0,0"/>
        <TextBox x:Name="AudioPath" Tag="输入 SqPack 内的 .scd 路径…" KeyDown="EnterPath" AutomationProperties.Name="SqPack 音频路径"/>
      </DockPanel>
      <Border Grid.Row="1" VerticalAlignment="Top" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="6" Padding="12">
    <StackPanel>
      <TextBlock x:Name="AudioDetails" Text="选择 .scd 文件以预览" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel Margin="0,0,0,6">
        <local:PlayPauseButton x:Name="PlayButton" Style="{StaticResource MediaPlaybackButton}" Click="PlayAudio" IsEnabled="False"/>
        <Button x:Name="StopButton" Style="{StaticResource StopPlaybackButton}" Click="StopAudio" IsEnabled="False"/>
        <Button x:Name="SaveButton" Content="导出音轨" Click="SaveAudio" IsEnabled="False" Width="38" Style="{StaticResource ExportButton}"/>
        <ComboBox x:Name="TrackSelector" MinWidth="110" Height="30" IsEnabled="False" SelectionChanged="SelectTrack"
                  AutomationProperties.Name="音轨"/>
      </WrapPanel>
      <DockPanel>
        <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="0:00" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" ValueChanged="SeekAudio"
                AutomationProperties.Name="播放进度"/>
      </DockPanel>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,0"/>
    </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
