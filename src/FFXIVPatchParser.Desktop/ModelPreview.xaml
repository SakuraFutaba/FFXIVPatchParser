<UserControl x:Class="FFXIVPatchParser.Desktop.ModelPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FFXIVPatchParser.Desktop"
             Unloaded="PreviewUnloaded" IsVisibleChanged="PreviewVisibilityChanged">
  <DockPanel Grid.IsSharedSizeScope="True">
    <Grid x:Name="Browser" DockPanel.Dock="Left" Width="310" Margin="0,0,8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" SharedSizeGroup="ModelToolbar"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,6">
        <TextBox x:Name="ModelSearch" Style="{StaticResource SearchTextBox}" Tag="名称、编号或路径…" AutomationProperties.Name="筛选模型"
                 TextChanged="FilterModels" IsEnabled="False"/>
      </StackPanel>
      <TreeView x:Name="ModelTree" Grid.Row="1" Style="{StaticResource CompactPathTree}" SelectedItemChanged="ModelSelected">
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <TextBlock x:Name="BrowserStatus" Grid.Row="2" Text="尚未扫描" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                 VerticalAlignment="Top"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
    <Grid x:Name="CharacterSidebar" DockPanel.Dock="Left" Width="360" Margin="0,0,8,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
      </Grid.RowDefinitions>
      <Border Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="6" Padding="10,8,2,8">
        <ScrollViewer x:Name="CharacterAppearanceScroll" Style="{StaticResource OverlayDetailScroll}">
          <StackPanel Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
              <RadioButton x:Name="RacePickerTab" GroupName="AppearancePicker" Style="{StaticResource WorkspacePageTab}"
                           Content="自选种族" IsChecked="True" Click="SwitchAppearancePicker"/>
              <RadioButton x:Name="NpcPickerTab" GroupName="AppearancePicker" Style="{StaticResource WorkspacePageTab}"
                           Content="NPC 外观" Click="SwitchAppearancePicker"/>
            </StackPanel>
            <Grid x:Name="RaceAppearancePicker" Margin="0,0,0,10">
              <ComboBox x:Name="CharacterRace" DisplayMemberPath="Label" AutomationProperties.Name="选择种族"
                        SelectionChanged="CharacterRaceChanged"/>
            </Grid>
            <StackPanel x:Name="NpcAppearancePicker" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBox x:Name="NpcAppearanceSearch" Style="{StaticResource SearchTextBox}" Tag="搜索 NPC 名称或编号…"
                         TextChanged="FilterNpcAppearance" KeyDown="NpcAppearanceSearchKeyDown" AutomationProperties.Name="搜索 NPC 外观"/>
                <ComboBox x:Name="NpcAppearanceChoice" DisplayMemberPath="Label" Margin="0,5,0,0"
                          SelectionChanged="NpcAppearanceChanged" AutomationProperties.Name="选择 NPC 外观"
                          ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                </ComboBox>
                <TextBlock x:Name="NpcAppearanceStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AppearanceContent">
              <Expander x:Name="CharacterParts" Header="装备、发型与脸型" Visibility="Collapsed" IsExpanded="True" Margin="0,0,0,8" Expanded="CharacterPartsExpanded">
                <StackPanel Margin="0,5,0,0">
                  <Grid x:Name="SlotGrid" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  </Grid>
                  <ComboBox Visibility="Collapsed" x:Name="PartSlot" DisplayMemberPath="Label" SelectionChanged="PartSlotChanged" AutomationProperties.Name="角色部位"/>
                  <StackPanel x:Name="CharacterPartEditor">
                  <TextBox x:Name="PartFilter" Style="{StaticResource SearchTextBox}" Tag="筛选部件名称…" TextChanged="PartFilterChanged" Margin="0,4,0,0" AutomationProperties.Name="筛选部件名称"/>
                  <DockPanel Margin="0,4,0,0">
                    <Button x:Name="CopyPartName" DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="复制装备名"
                            Click="CopySelectedPartName" Margin="6,0,0,0" IsEnabled="False"/>
                  <ComboBox x:Name="PartChoice" TextSearch.TextPath="Label" VerticalAlignment="Center"
                            SelectionChanged="PartChoiceChanged" AutomationProperties.Name="角色部件"
                            ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ComboBox.ItemTemplate><DataTemplate><DockPanel>
                      <Image Width="22" Height="22" Margin="0,0,6,0" Loaded="PartIconLoaded" DataContextChanged="PartIconChanged"/>
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel></DataTemplate></ComboBox.ItemTemplate>
                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                  </ComboBox>
                  </DockPanel>
                  <CheckBox x:Name="WeaponSheathed" Content="收起武器" Margin="0,5" Click="WeaponSheathedChanged"/>
                  </StackPanel>
                  <TextBlock x:Name="PartStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Expander>
              <Expander x:Name="CharacterAppearance" Header="角色配色" Visibility="Collapsed" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="0,5,0,0">
                <Grid x:Name="PlayerColors">
                  <Grid.Resources>
                    <DataTemplate x:Key="PaletteChoice">
                      <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
                                Background="{Binding Brush}" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                        <TextBlock Text="{Binding Label}"/>
                      </StackPanel>
                    </DataTemplate>
                    <Style x:Key="PalettePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                      <Setter Property="ItemTemplate" Value="{StaticResource PaletteChoice}"/>
                      <Setter Property="Margin" Value="0,0,0,4"/>
                      <Setter Property="MaxDropDownHeight" Value="320"/>
                      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                      <Setter Property="ItemsPanel">
                        <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
                      </Setter>
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="部族" Margin="0,0,0,2"/>
                    <ComboBox x:Name="TribeColors" DisplayMemberPath="Name" Padding="5,3"
                              SelectionChanged="AppearanceTribeChanged" AutomationProperties.Name="角色部族" Margin="0,0,0,4"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="肤色" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SkinColors" Style="{StaticResource PalettePicker}"
                              SelectionChanged="AppearanceColorChanged" AutomationProperties.Name="角色肤色"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock Text="发色" Margin="0,0,0,2"/>
                    <ComboBox x:Name="HairColors" Style="{StaticResource PalettePicker}"
                              SelectionChanged="AppearanceColorChanged" AutomationProperties.Name="角色发色"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="挑染" Margin="0,0,0,2"/>
                    <ComboBox x:Name="HighlightColors" Style="{StaticResource PalettePicker}"
                              SelectionChanged="AppearanceColorChanged" AutomationProperties.Name="角色挑染色"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2">
                    <TextBlock Text="瞳色" Margin="0,0,0,2"/>
                    <ComboBox x:Name="EyeColors" Style="{StaticResource PalettePicker}"
                              SelectionChanged="AppearanceColorChanged" AutomationProperties.Name="角色瞳色"/>
                  </StackPanel>
                  <DockPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button x:Name="ResetPalette" DockPanel.Dock="Right" Content="恢复默认" Click="ResetAppearance" Margin="6,0,0,0"/>
                    <TextBlock x:Name="AppearanceStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                  </DockPanel>
                </Grid>
                <StackPanel x:Name="NpcColors" Visibility="Collapsed">
                  <TextBlock x:Name="NpcTribeName" Margin="0,0,0,5"/>
                  <ItemsControl x:Name="NpcColorItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                          <Border Background="{Binding Brush}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding Label}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                </Grid>
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ModelToolbarRow" Height="Auto" SharedSizeGroup="ModelToolbar"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
      </Grid.RowDefinitions>
      <DockPanel x:Name="ModelPathToolbar" Margin="0,0,0,6">
        <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="读取模型" Style="{StaticResource Primary}" Click="LoadModel"
                Margin="6,0,0,0" VerticalAlignment="Top"/>
        <Button x:Name="CatalogueOptions" DockPanel.Dock="Right" Click="ToggleCatalogueOptions" Margin="8,0,0,0"
                VerticalAlignment="Top" Visibility="{Binding Visibility, ElementName=Browser}"
                AutomationProperties.Name="模型扫描选项">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="扫描选项"/>
            <Path Width="8" Height="4" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>
        </Button>
        <TextBox x:Name="ModelPath" Tag="输入 SqPack 内的 .mdl 路径…" KeyDown="ModelPathKeyDown" VerticalAlignment="Top"
                 AutomationProperties.Name="模型路径" ToolTip="例如 chara/human/c0101/obj/hair/h0001/model/c0101h0001_hir.mdl"/>
      </DockPanel>
      <Popup x:Name="CatalogueOptionsPopup" PlacementTarget="{Binding ElementName=CatalogueOptions}" Placement="Bottom"
             AllowsTransparency="True" VerticalOffset="5" Opened="CatalogueOptionsOpened" Closed="CatalogueOptionsClosed">
          <Border x:Name="CatalogueOptionsPanel" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="8" Padding="10" PreviewKeyDown="CatalogueOptionsKeyDown"
                  KeyboardNavigation.TabNavigation="Cycle">
            <StackPanel Width="235">
              <Button x:Name="NpcNamesButton" Content="补充 NPC 名称" Click="DownloadNpcNames" Padding="6,3" Margin="0,6,0,0"
                      HorizontalAlignment="Left" ToolTip="读取 Anamnesis 名称映射，尝试更新中文对照，再重建模型目录。"/>
              <Expander x:Name="CatalogueScanOptions" Header="模型路径扫描" Margin="0,6,0,0">
                <StackPanel>
                  <Button x:Name="UnknownModelsButton" Content="扫描未知模型" Click="ScanUnknownModels" Padding="6,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                          ToolTip="逐项读取 DAT 文件头，查找没有已知路径的模型；可能耗时较长。"/>
                  <CheckBox x:Name="ScanAllModels" Content="包含场景等模型（较慢）" Margin="0,6,0,0"
                            ToolTip="默认扫描角色容器。勾选后再次扫描可查找其他容器中的模型。"/>
                  <Button x:Name="ModelPathsButton" Content="导入已知模型路径" Click="ImportModelPaths" Padding="6,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                          ToolTip="导入每行一个游戏内 .mdl 路径的 UTF-8 文本。匹配本地索引后显示路径，未知项仍保留 SqPack 地址。"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
      </Popup>
      <DockPanel Grid.Row="2">
        <Border x:Name="Inspector" DockPanel.Dock="Right" Width="208" Margin="8,0,0,0" Background="{StaticResource WorkspaceSurface}"
                BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6" Padding="9" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
              <TextBlock x:Name="ModelEntryInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                  <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <DockPanel x:Name="ItemDyePanel" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="装备染色" VerticalAlignment="Center" />
                <Grid x:Name="ItemDyeControls" Height="22" HorizontalAlignment="Right"/>
              </DockPanel>
              <Button x:Name="ItemHandButton" Visibility="Collapsed" Click="SwitchItemHand" Margin="0,0,0,6"/>
              <WrapPanel x:Name="ModelTableLinks" Visibility="Collapsed" Margin="0,0,0,8">
                <Button Content="来源行" Tag="source" Click="OpenModelTable" Padding="5,3" Margin="0,0,4,3"/>
                <Button x:Name="NameTableLink" Content="名称行" Tag="name" Click="OpenModelTable" Padding="5,3" Margin="0,0,4,3"/>
                <Button Content="ModelChara" Tag="model" Click="OpenModelTable" Padding="5,3" Margin="0,0,0,3"/>
              </WrapPanel>
              <Button x:Name="MaterialsButton" Content="材质与纹理" Click="OpenInspectorPopup"  Margin="0,0,0,6"/>
              <Popup x:Name="MaterialsPopup" PlacementTarget="{Binding ElementName=MaterialsButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10" CornerRadius="6">
                  <ScrollViewer Width="330" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                      <WrapPanel>
        <CheckBox x:Name="UseTextures" Content="基础色纹理" IsChecked="True" IsEnabled="False" Margin="0,0,12,0"
                  VerticalAlignment="Center" Checked="ChangeDisplay" Unchecked="ChangeDisplay"/>
        <TextBlock Text="材质变体" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="MaterialVariant" Text="1" Width="43" Padding="5,3" KeyDown="ModelPathKeyDown"
                 AutomationProperties.Name="材质变体" ToolTip="输入变体编号后按 Enter 或重新读取模型"/>
                      </WrapPanel>
              <TextBlock Text="材质" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <ComboBox x:Name="MaterialChoice" SelectionChanged="MaterialSelected" DisplayMemberPath="Label"
                        AutomationProperties.Name="材质筛选" Padding="5,3" HorizontalContentAlignment="Stretch"/>
              <TextBlock x:Name="MaterialDetails" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Expander x:Name="ShaderInspector" Header="着色器包" Expanded="ShowMaterialShader" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBox x:Name="ShaderDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MaxHeight="180" Margin="0,3,0,0" AutomationProperties.Name="着色器元数据"/>
              </Expander>
              <ComboBox x:Name="TextureChoice" SelectionChanged="TextureSelected" DisplayMemberPath="Label"
                        AutomationProperties.Name="材质贴图" Padding="5,3" Margin="0,8,0,0" Visibility="Collapsed"/>
              <Image x:Name="TextureImage" Height="100" Stretch="Uniform" Visibility="Collapsed" Margin="0,6,0,0"/>
              <TextBlock x:Name="TextureStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Popup>
              <Separator Margin="0,8"/>
              <TextBlock Text="骨骼与动作" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <TextBlock x:Name="AnimationStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Expander x:Name="BoneList" Header="骨骼名称" Margin="0,6,0,0">
                <TextBox x:Name="BoneNames" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MaxHeight="150"/>
              </Expander>
              <Expander x:Name="ActionList" Header="动作资源" IsExpanded="True" Margin="0,8,0,0" Expanded="ActionListExpanded">
                <StackPanel Margin="0,5,0,0">
                  <TextBox x:Name="ActionFilter" Style="{StaticResource SearchTextBox}" Tag="筛选技能、情感动作或路径…" AutomationProperties.Name="筛选动作候选"
                           IsEnabled="False" TextChanged="FilterActions" Padding="5,3" Margin="0,0,0,5"/>
                  <DockPanel Margin="0,6,0,0">
                    <Button Content="读取" DockPanel.Dock="Right" Click="LoadAction" Padding="5,3" Margin="4,0,0,0"/>
                    <TextBox x:Name="ActionPath" Tag="输入 .pap 路径…" Padding="5,3" KeyDown="ActionPathKeyDown"
                             AutomationProperties.Name="动作资源路径"/>
                  </DockPanel>
                  <TextBlock x:Name="ActionMetadataStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <Grid Height="26">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousAction" Style="{StaticResource PreviousItemButton}" Click="SelectPreviousAction" Margin="0,0,4,0"
                            IsEnabled="False" ToolTip="上一个动作文件" AutomationProperties.Name="上一个动作文件"/>
                    <ComboBox x:Name="ActionChoice" local:ComboStep.HasExternalButtons="True" Grid.Column="1" SelectionChanged="ActionSelected" ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="模型动作资源" IsEnabled="False" Padding="5,3">
                      <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                      </ComboBox.ItemsPanel>
                      <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="NextAction" Grid.Column="2" Style="{StaticResource NextItemButton}" Click="SelectNextAction" Margin="4,0,0,0"
                            IsEnabled="False" ToolTip="下一个动作文件" AutomationProperties.Name="下一个动作文件"/>
                  </Grid>

                  <Grid x:Name="PlaybackSlotPicker" Height="26" Visibility="Collapsed" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousPlaybackSlot" Style="{StaticResource PreviousItemButton}" Click="SelectPreviousPlaybackSlot" Margin="0,0,4,0"
                            ToolTip="上一个动作槽" AutomationProperties.Name="上一个动作槽"/>
                    <ComboBox x:Name="PlaybackSlot" local:ComboStep.HasExternalButtons="True" Grid.Column="1" SelectionChanged="PlaybackSlotChanged" AutomationProperties.Name="动作槽"
                              Padding="5,3">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Index, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="NextPlaybackSlot" Grid.Column="2" Style="{StaticResource NextItemButton}" Click="SelectNextPlaybackSlot" Margin="4,0,0,0"
                            ToolTip="下一个动作槽" AutomationProperties.Name="下一个动作槽"/>
                  </Grid>
                  <TextBlock x:Name="ActionDiscoveryStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <local:AnimationDetails x:Name="ActionRelations" Visibility="Collapsed" Margin="0,5,0,0"
                                          RelatedTableRequested="OpenActionTable"/>
                </StackPanel>
              </Expander>
              <WrapPanel Margin="0,5,0,0">
                <local:PlayPauseButton x:Name="PlaybackStart" Style="{StaticResource MediaPlaybackButton}" Click="PlayAnimation" IsEnabled="False"/>
                <Button x:Name="PlaybackStop" Style="{StaticResource StopPlaybackButton}" Click="StopAnimation" IsEnabled="False"/>
              </WrapPanel>
              <Slider x:Name="PlaybackPosition" Minimum="0" Maximum="1" IsEnabled="False"
                      IsMoveToPointEnabled="True" ValueChanged="SeekAnimation" Margin="0,5,0,0"
                      AutomationProperties.Name="动作播放进度"/>
              <TextBlock x:Name="PlaybackPositionText" Text="0.00 / 0.00 秒" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="PlaybackStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border x:Name="ModelSurface" Background="#202B3A" CornerRadius="6" ClipToBounds="True" FocusVisualStyle="{x:Null}"
                Focusable="True" AutomationProperties.Name="3D 模型视口">
          <Grid>
            <Viewport3D x:Name="ModelViewport" IsHitTestVisible="False" ClipToBounds="True">
              <Viewport3D.Camera>
                <PerspectiveCamera x:Name="ViewCamera" UpDirection="0,1,0" FieldOfView="55"/>
              </Viewport3D.Camera>
              <ModelVisual3D>
                <ModelVisual3D.Content>
                  <Model3DGroup>
                    <AmbientLight Color="#717985"/>
                    <DirectionalLight Color="#ECEFF5" Direction="-1,-2,-3"/>
                    <DirectionalLight Color="#677C97" Direction="2,-0.2,1"/>
                  </Model3DGroup>
                </ModelVisual3D.Content>
              </ModelVisual3D>
              <ModelVisual3D x:Name="ModelVisual"/>
              <ModelVisual3D x:Name="ItemEffectVisual"/>
            </Viewport3D>
            <Button x:Name="ResetButton" Content="重置视图" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="9,4" IsEnabled="False" Click="ResetView"/>
            <TextBlock x:Name="EmptyViewport" Text="选择或输入模型路径" Foreground="#CFD8E5" Margin="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="CameraHelp" Text="W/S 前后 · A/D 转向 · 鼠标键+A/D 横移 · 左右键同按前进&#10;Shift 加速 · Ctrl 减速 · 空格上升 · Q 下降" Foreground="#CFD8E5"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,10,8"
                       TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </DockPanel>
      <TextBlock x:Name="ModelInfo" Grid.Row="3" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                 VerticalAlignment="Top"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                 AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </DockPanel>
</UserControl>
