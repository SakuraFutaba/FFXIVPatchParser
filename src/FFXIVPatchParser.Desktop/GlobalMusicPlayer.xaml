  <Geometry x:Key="FavoriteOutline">M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z</Geometry>
  <Geometry x:Key="FavoriteFilled">M20.884 13.19c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z</Geometry>
  <Geometry x:Key="MusicVolume">F1 M9.741.85a.75.75 0 0 1 .375.65v13a.75.75 0 0 1-1.125.65l-6.925-4a3.64 3.64 0 0 1-1.33-4.967 3.64 3.64 0 0 1 1.33-1.332l6.925-4a.75.75 0 0 1 .75 0zm-6.924 5.3a2.14 2.14 0 0 0 0 3.7l5.8 3.35V2.8zm8.683 4.29V5.56a2.75 2.75 0 0 1 0 4.88 M11.5 13.614a5.752 5.752 0 0 0 0-11.228v1.55a4.252 4.252 0 0 1 0 8.127z</Geometry>
  <Geometry x:Key="MusicMuted">F1 M13.86 5.47a.75.75 0 0 0-1.061 0l-1.47 1.47-1.47-1.47A.75.75 0 0 0 8.8 6.53L10.269 8l-1.47 1.47a.75.75 0 1 0 1.06 1.06l1.47-1.47 1.47 1.47a.75.75 0 0 0 1.06-1.06L12.39 8l1.47-1.47a.75.75 0 0 0 0-1.06 M10.116 1.5A.75.75 0 0 0 8.991.85l-6.925 4a3.64 3.64 0 0 0-1.33 4.967 3.64 3.64 0 0 0 1.33 1.332l6.925 4a.75.75 0 0 0 1.125-.649v-1.906a4.7 4.7 0 0 1-1.5-.694v1.3L2.817 9.852a2.14 2.14 0 0 1-.781-2.92c.187-.324.456-.594.78-.782l5.8-3.35v1.3c.45-.313.956-.55 1.5-.694z</Geometry>
  <Style x:Key="MusicLineIcon" TargetType="Path"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Fill" Value="{x:Null}"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style>
  <Style x:Key="MusicTab" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource ShellHover}"/><Setter Property="Foreground" Value="{DynamicResource ShellText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource ShellBorder}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource ShellAccent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="MusicHoverContent" TargetType="ContentPresenter">
    <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
    <Setter Property="Opacity" Value="0.88"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12"/></Setter.Value></Setter>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="MusicIcon" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="2,0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter Style="{StaticResource MusicHoverContent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellText}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellHover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MusicPlay" TargetType="Button" BasedOn="{StaticResource MusicIcon}"><Setter Property="Foreground" Value="{DynamicResource ShellBase}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{DynamicResource ShellAccent}" CornerRadius="17"><ContentPresenter Style="{StaticResource MusicHoverContent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellText}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MusicToggle" TargetType="ToggleButton">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
       <ContentPresenter Style="{StaticResource MusicHoverContent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellText}"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellText}"/></Trigger>
       <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellAccent}"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ShellHover}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="MusicSearch" TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
   <Setter Property="Background" Value="{DynamicResource ShellRaised}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ShellBorder}"/>
   <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource ShellText}"/>
  </Style>
  <Style x:Key="MusicPath" TargetType="Path"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/></Style>
  <Style x:Key="MusicSlider" TargetType="Slider">
   <Setter Property="Height" Value="18"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" VerticalAlignment="Center"><Border Height="3" Background="{DynamicResource ShellTrack}" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="3" Background="{DynamicResource ShellAccent}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="10" Height="10"><Thumb.Template><ControlTemplate><Ellipse Fill="{DynamicResource ShellAccent}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="PlayerSurface" Height="74" Background="{DynamicResource ShellBase}">
  <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=PlayerSurface}" Placement="Custom"
         StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Opened="QueueOpened" Closed="QueueClosed">
    <Border x:Name="QueuePanel" Width="760" Height="320" Background="{DynamicResource ShellRaised}" BorderBrush="{DynamicResource ShellBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" PreviewKeyDown="PlayerKeyDown">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ListBox x:Name="LibraryMode" SelectedIndex="0" SelectionChanged="LibraryModeChanged" Background="{DynamicResource ShellBase}" Foreground="{DynamicResource ShellMuted}" BorderThickness="0" ItemContainerStyle="{StaticResource MusicTab}" AutomationProperties.Name="音乐列表来源"><ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" CornerRadius="4"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="播放队列"/><ListBoxItem Content="本地曲库"/><ListBoxItem Content="收藏列表"/></ListBox>
       <TextBox x:Name="Search" Style="{StaticResource MusicSearch}" Grid.Column="1" Margin="12,0" TextChanged="Filter"
                Tag="搜索曲名、场景或路径…" AutomationProperties.Name="搜索曲名、场景或路径"/>
       <Button x:Name="AddToQueueButton" Grid.Column="2" Style="{StaticResource MusicIcon}" Width="106" Height="32" Padding="10,4" Background="{DynamicResource ShellBorder}" Content="加入队列" Click="AddToQueue"/>
      </Grid>
      <TextBlock x:Name="QueueStatus" DockPanel.Dock="Bottom" Foreground="{DynamicResource ShellMuted}" Margin="0,6,0,0"/>
      <ListBox x:Name="QueueList" Background="{DynamicResource ShellRaised}" Foreground="{DynamicResource ShellText}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Choose" KeyDown="ChooseKey">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource ShellText}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ShellHover}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ShellHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Grid.Column="1" Text="{Binding Subtitle}" Foreground="{DynamicResource ShellMuted}" TextTrimming="CharacterEllipsis" Margin="20,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
  </Popup>
    <Grid Height="74" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="180"/><ColumnDefinition Width="4*" MinWidth="220"/><ColumnDefinition Width="3*" MinWidth="180"/></Grid.ColumnDefinitions>
     <Button x:Name="OpenAudioPageButton" Margin="0,0,16,0" Background="Transparent" Cursor="Hand"
             Height="54" VerticalAlignment="Center" Click="OpenAudioPage" ToolTip="打开 SqPack 音频" AutomationProperties.Name="打开 SqPack 音频">
      <Button.Template>
       <ControlTemplate TargetType="Button">
        <Border x:Name="TrackArea" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TrackArea" Property="Background" Value="{DynamicResource ShellHover}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Button.Template>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" Background="{DynamicResource ShellRaised}" CornerRadius="5"><Path Width="23" Height="26" Stretch="Uniform" Fill="{DynamicResource ShellMuted}" Data="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0"><TextBlock x:Name="TrackTitle" Text="音乐播放器" Foreground="{DynamicResource ShellText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackSubtitle" Text="选择一首音乐开始播放" Foreground="{DynamicResource ShellMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
     </Grid>
     </Button>
     <Grid Grid.Column="1" Margin="8,6"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <ToggleButton x:Name="Shuffle" Style="{StaticResource MusicToggle}" Click="ShuffleChanged" ToolTip="随机播放已关闭" AutomationProperties.Name="随机播放已关闭"><Path Style="{StaticResource MusicLineIcon}" Data="{StaticResource MusicShuffle}"/></ToggleButton>
       <Button Style="{StaticResource MusicIcon}" Click="Previous" ToolTip="上一首" AutomationProperties.Name="上一首"><Path Style="{StaticResource MusicPath}" Data="M3.3 1a.7.7 0 0 1 .7.7v5.15l9.95-5.744a.7.7 0 0 1 1.05.606v12.575a.7.7 0 0 1-1.05.607L4 9.149V14.3a.7.7 0 0 1-.7.7H1.7a.7.7 0 0 1-.7-.7V1.7a.7.7 0 0 1 .7-.7z"/></Button>
       <local:PlayPauseButton x:Name="MainPlay" Style="{StaticResource MusicPlay}" Width="34" Height="34" Background="{DynamicResource ShellAccent}" Foreground="{DynamicResource ShellBase}" Margin="10,0" Click="PlayPause" IsEnabled="False"/>
       <Button Style="{StaticResource MusicIcon}" Click="Next" ToolTip="下一首" AutomationProperties.Name="下一首"><Path Style="{StaticResource MusicPath}" Data="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.107A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V14.3a.7.7 0 0 0 .7.7h1.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7z"/></Button>
       <Button x:Name="Repeat" Style="{StaticResource MusicIcon}" Click="RepeatChanged" ToolTip="循环：关闭" AutomationProperties.Name="切换循环模式"><Path x:Name="RepeatGlyph" Style="{StaticResource MusicLineIcon}" Data="{StaticResource MusicRepeat}"/></Button>
      </StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{DynamicResource ShellMuted}" VerticalAlignment="Center"/><Slider x:Name="Position" Grid.Column="1" Style="{StaticResource MusicSlider}" Minimum="0" Maximum="1" ValueChanged="Seek" IsEnabled="False" AutomationProperties.Name="播放进度"/><local:LoopRangeMarks x:Name="LoopMarkers" Grid.Column="1" Margin="5,0" IsHitTestVisible="False"/><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{DynamicResource ShellMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
     </Grid>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="MuteButton" Style="{StaticResource MusicIcon}" Click="ToggleMute" ToolTip="静音" AutomationProperties.Name="静音">
        <Canvas Width="16" Height="16">
          <Path x:Name="VolumeGlyph" Fill="{Binding Foreground, ElementName=MuteButton}" Data="{StaticResource MusicVolume}"/>
        </Canvas>
      </Button>
      <Slider x:Name="VolumeSlider" Width="76" Style="{StaticResource MusicSlider}" Minimum="0" Maximum="1" Value="0.6" ValueChanged="VolumeChanged" AutomationProperties.Name="音乐音量"/>
      <ToggleButton x:Name="FavoriteButton" Style="{StaticResource MusicToggle}" Margin="10,0,2,0" IsEnabled="False"
                    Click="Favorite" ToolTip="收藏" AutomationProperties.Name="收藏">
       <Path x:Name="FavoriteGlyph">
        <Path.Style>
         <Style TargetType="Path" BasedOn="{StaticResource MusicPath}">
          <Setter Property="Data" Value="{StaticResource FavoriteOutline}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsChecked, ElementName=FavoriteButton}" Value="True">
            <Setter Property="Data" Value="{StaticResource FavoriteFilled}"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Path.Style>
       </Path>
      </ToggleButton>
      <ToggleButton x:Name="QueueToggle" Style="{StaticResource MusicToggle}" Click="ToggleQueue"
                    ToolTip="播放队列与本地曲库" AutomationProperties.Name="播放队列与本地曲库">
       <Path Style="{StaticResource MusicLineIcon}" Data="{StaticResource MusicList}"/>
      </ToggleButton>
     </StackPanel>
     <TextBlock Grid.Column="2" x:Name="FavoriteFeedback" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                FontSize="11" Margin="0,0,2,3" Foreground="{DynamicResource ShellAccent}" IsHitTestVisible="False"
                AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  <local:AudioPreview x:Name="Playback" ShowBrowser="False" Visibility="Collapsed"/>
 </Grid>
</UserControl>
