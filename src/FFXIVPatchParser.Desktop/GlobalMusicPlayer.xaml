<UserControl x:Class="FFXIVPatchParser.Desktop.GlobalMusicPlayer"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FFXIVPatchParser.Desktop"
 PreviewKeyDown="PlayerKeyDown">
 <UserControl.Resources>
  <!-- Lucide 官方 SVG 移植；来源和 ISC 许可见 THIRD-PARTY-NOTICES.txt。 -->
