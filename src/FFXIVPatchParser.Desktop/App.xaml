  <DataTemplate x:Key="CopyIcon">
    <Viewbox Width="18" Height="18" Focusable="False">
      <Canvas Width="21" Height="21">
        <Path Data="{StaticResource CopyGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      </Canvas>
    </Viewbox>
  </DataTemplate>
  <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="5,4"/>
    <Setter Property="ContentTemplate" Value="{StaticResource CopyIcon}"/>
    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style x:Key="ClearSearchButton" TargetType="Button">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,0,3,0"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ToolTip" Value="清除搜索文字"/>
    <Setter Property="AutomationProperties.Name" Value="清除搜索文字"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="3">
            <!-- Microsoft VS Code Codicons close, CC BY 4.0. See THIRD-PARTY-NOTICES.txt. -->
            <Path Width="12" Height="12" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{TemplateBinding Foreground}"
