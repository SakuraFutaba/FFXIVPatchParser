          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF2F6"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#DCEAFE"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="TextBoxWithHint" TargetType="TextBox">
    <Border x:Name="Field" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="PART_ContentHost" BorderThickness="0" Focusable="False"/>
        <!-- WPF 文本视图自带 2 DIP 的水平留白，占位文字沿用同一位置。 -->
        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0"
                   TextAlignment="{TemplateBinding TextAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                   Foreground="#98A2B3" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Button x:Name="ClearSearch" Grid.Column="1" Style="{StaticResource ClearSearchButton}" Click="ClearSearchText"
                VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="local:App.ShowSearchClearButton" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
          <Condition Property="IsReadOnly" Value="False"/>
        </MultiTrigger.Conditions>
        <Setter TargetName="ClearSearch" Property="Visibility" Value="Visible"/>
      </MultiTrigger>
      <Trigger Property="Text" Value="">
        <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
        <Setter TargetName="ClearSearch" Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#6B9AF5"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource WorkspaceSurface}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template" Value="{StaticResource TextBoxWithHint}"/>
  </Style>
  <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="local:App.ShowSearchClearButton" Value="True"/>
  </Style>
  <Style x:Key="RoundedPreviewFrame" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource WorkspaceSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="1"/>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{StaticResource WorkspaceSurface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="RowHeight" Value="34"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
    <Setter Property="AlternatingRowBackground" Value="#F6F9FC"/>
    <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="SelectionMode" Value="Single"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F1F5FA"/><Setter Property="Foreground" Value="#4B5D75"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="HiddenTableRowHeader" TargetType="DataGridRowHeader"><Setter Property="Template" Value="{x:Null}"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Path Width="16" Height="16" Data="{StaticResource ExportGlyph}" Stretch="Uniform"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource ShellMuted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="8,3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="NavSurface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <DockPanel LastChildFill="True">
              <Path x:Name="NavIcon" DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,7,0"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform"
                    Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="NavIcon" Property="Visibility" Value="Collapsed"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="Tag" Value="{StaticResource FolderNavGlyph}"/></MultiTrigger.Conditions>
              <Setter TargetName="NavIcon" Property="Data" Value="{StaticResource FolderOpenNavGlyph}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource ShellAccent}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource ShellRaised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource ShellHover}"/>
              <Setter Property="Foreground" Value="{StaticResource ShellText}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavChild" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
    <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="8,1"/>
  </Style>
  <Style x:Key="NavigationGroup" TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource ShellText}"/><Setter Property="Margin" Value="8,5,8,4"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                          Foreground="{TemplateBinding Foreground}" Background="Transparent" Cursor="Hand"
                          FocusVisualStyle="{x:Null}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{TemplateBinding Header}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="HeaderBox" Padding="11,7" Background="{TemplateBinding Background}" CornerRadius="6">
                    <DockPanel>
                      <Path x:Name="Arrow" DockPanel.Dock="Right" Style="{StaticResource ChevronIcon}"
                            Stroke="{TemplateBinding Foreground}" Data="{StaticResource ChevronRight}" Margin="6,0,0,0"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource ShellAccent}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="{StaticResource ChevronDown}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBox" Property="Background" Value="{StaticResource ShellRaised}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="GroupContent" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="GroupContent" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
 </ResourceDictionary>
</Application.Resources>
</Application>
