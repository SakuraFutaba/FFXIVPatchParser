<Window x:Class="FFXIVPatchParser.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FFXIVPatchParser.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="FFXIV Patch Parser" Width="1480" Height="920" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBase}"
 UseLayoutRounding="True" PreviewKeyDown="NavigationKeys">
<shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/>
</shell:WindowChrome.WindowChrome>
<DockPanel x:Name="WindowContent">
  <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource ShellBase}">
    <Grid>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化">
          <Canvas Width="14" Height="14">
            <Path Data="M 2,7 H 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Canvas>
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow" ToolTip="最大化" AutomationProperties.Name="最大化">
          <Canvas Width="14" Height="14">
            <Path x:Name="MaximizeGlyph" Data="M 2,2 H 12 V 12 H 2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Canvas>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口">
          <Canvas Width="14" Height="14">
            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Canvas>
        </Button>
      </StackPanel>
      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <Border x:Name="TitleBadge" Width="22" Height="22" Background="{StaticResource ShellAccent}" CornerRadius="5" Margin="0,0,10,0"
                VerticalAlignment="Center" AutomationProperties.Name="XIV">
          <Path Width="14" Height="8" Stretch="Uniform" Stroke="{StaticResource ShellBase}" StrokeThickness="1.4"
                HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 5,8 M 5,0 L 0,8 M 7.4,0 V 8 M 9.8,0 L 12.4,8 L 15,0"/>
        </Border>
        <Button x:Name="BackButton" Style="{StaticResource HistoryButton}" Click="NavigateBack" IsEnabled="False"
                ToolTip="后退 (Alt+←)" AutomationProperties.Name="后退" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Width="13" Height="12" Stretch="Uniform" Data="M 5,0 L 0,5 L 5,10 M 0,5 H 11"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
        </Button>
        <Button x:Name="ForwardButton" Style="{StaticResource HistoryButton}" Click="NavigateForward" IsEnabled="False"
                ToolTip="前进 (Alt+→)" AutomationProperties.Name="前进" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Width="13" Height="12" Stretch="Uniform" Data="M 6,0 L 11,5 L 6,10 M 11,5 H 0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
        </Button>
      </StackPanel>
      <TextBlock x:Name="CaptionText" Text="FFXIV Patch Parser" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource ShellText}" FontSize="12" IsHitTestVisible="False" SizeChanged="CenterCaptionText"/>
    </Grid>
  </Border>
<local:GlobalMusicPlayer x:Name="MusicPlayer" DockPanel.Dock="Bottom"/>
<Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource ShellBase}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="18,11,12,17">
        <Grid Height="28">
          <TextBlock x:Name="BrandMark" Text="XIV" Foreground="{StaticResource ShellAccent}" FontSize="22" FontWeight="Bold"
                     VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="BrandName" Text="PATCH PARSER" Foreground="{StaticResource ShellText}" FontSize="12"
                   FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        <Viewbox Width="{Binding ActualWidth, ElementName=BrandName}" HorizontalAlignment="Left" Margin="0,4,0,0">
          <TextBlock Text="Parse everything" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
        </Viewbox>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,1,0,0" Margin="16,10,12,14" Padding="2,10,0,0">
        <StackPanel>
          <TextBlock Text="SqPack 游戏版本" Foreground="{StaticResource ShellMuted}" FontSize="11"/>
          <TextBlock x:Name="SqPackVersion" Text="未连接" Foreground="{StaticResource ShellText}" FontSize="11" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/>
          <TextBlock Text="Patch 补丁版本" Foreground="{StaticResource ShellMuted}" FontSize="11" Margin="0,10,0,0"/>
          <TextBlock x:Name="DiffVersion" Text="未选择" Foreground="{StaticResource ShellText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock x:Name="DiffGameVersions" Foreground="{StaticResource ShellMuted}" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
          <RadioButton x:Name="CatalogNav" GroupName="Nav" Style="{StaticResource Nav}" Content="补丁目录" Checked="Navigate"/>
          <Expander x:Name="PatchNavigation" Header="Patch" Style="{StaticResource NavigationGroup}" IsExpanded="True">
            <StackPanel>
              <RadioButton x:Name="PatchNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource FolderNavGlyph}" Content="文件系统" IsChecked="True" Checked="Navigate"/>
              <RadioButton x:Name="DiffNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource TableNavGlyph}" Content="表格" Checked="Navigate"/>
              <RadioButton x:Name="PatchImagesNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource ImageNavGlyph}" Content="图片" Checked="Navigate"/>
              <RadioButton x:Name="PatchModelsNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource ModelNavGlyph}" Content="模型" Checked="Navigate"/>
              <RadioButton x:Name="PatchAudioNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource AudioNavGlyph}" Content="音频" Checked="Navigate"/>
            </StackPanel>
          </Expander>
          <Expander x:Name="LocalNavigation" Header="SqPack" Style="{StaticResource NavigationGroup}" IsExpanded="True">
            <StackPanel>
              <RadioButton x:Name="LocalFilesNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource FolderNavGlyph}" Content="文件系统" Checked="Navigate"/>
              <RadioButton x:Name="SqPackNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource TableNavGlyph}" Content="表格" Checked="Navigate"/>
              <RadioButton x:Name="LocalImagesNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource ImageNavGlyph}" Content="图片" Checked="Navigate"/>
              <RadioButton x:Name="LocalModelsNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource ModelNavGlyph}" Content="模型" Checked="Navigate"/>
              <RadioButton x:Name="LocalMapsNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource MapNavGlyph}" Content="地图" Checked="Navigate"/>
              <RadioButton x:Name="LocalAudioNav" GroupName="Nav" Style="{StaticResource NavChild}" Tag="{StaticResource AudioNavGlyph}" Content="音频" Checked="Navigate"/>
            </StackPanel>
          </Expander>
          <RadioButton x:Name="SettingsNav" GroupName="Nav" Style="{StaticResource Nav}" Content="设置" Checked="Navigate"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
  <Border Grid.Column="1" x:Name="WorkspaceFrame" Margin="0,0,8,0" CornerRadius="12"
          Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
  <Grid Grid.Column="1" Margin="16,12,24,8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Height="28" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBox x:Name="PatchFileSearch" Style="{StaticResource SearchTextBox}" Width="295"
                 Tag="搜索补丁文件路径或类别…" TextChanged="FilterPatchFiles" AutomationProperties.Name="搜索补丁文件"/>
        <Button x:Name="ScanMediaButton" Click="ScanCurrentMedia" Width="112" Margin="0"
                IsEnabled="False" Visibility="Collapsed"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Left" x:Name="PageTitle" Text="Patch · 文件系统" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Grid Margin="14,0,0,0" VerticalAlignment="Center">
        <ContentControl x:Name="LocalTableHeader" IsTabStop="False" HorizontalContentAlignment="Stretch"/>
        <ScrollViewer x:Name="DiffTableHeader" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="DiffTableTabStrip" Orientation="Horizontal"/>
        </ScrollViewer>
        <StackPanel x:Name="ImagePageTabs" Orientation="Horizontal" Visibility="Collapsed">
          <RadioButton x:Name="TexturePageTab" Style="{StaticResource WorkspacePageTab}" GroupName="ImagePage" Content="图片" IsChecked="True" Checked="ImagePageChanged"/>
          <RadioButton x:Name="IconPageTab" Style="{StaticResource WorkspacePageTab}" GroupName="ImagePage" Content="图标浏览器" Checked="ImagePageChanged"/>
          <RadioButton x:Name="UldPageTab" Style="{StaticResource WorkspacePageTab}" GroupName="ImagePage" Content="ULD" Checked="ImagePageChanged"/>
        </StackPanel>
      </Grid>
    </DockPanel>
    <Grid Grid.Row="1" x:Name="PatchWorkspace" UseLayoutRounding="True" Grid.IsSharedSizeScope="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="295" MinWidth="200" MaxWidth="480"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="570"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto" SharedSizeGroup="PatchFooter"/></Grid.RowDefinitions>
      <TreeView x:Name="ResourcesTree" Style="{StaticResource CompactPathTree}" SelectedItemChanged="ResourceSelected">
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000">
              <TextBlock.ToolTip>
                <StackPanel MaxWidth="480">
                  <TextBlock Text="{Binding FullPath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock><Run Text="{Binding Payload.Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Payload.SizeLabel, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Payload.Entry, StringFormat='ZIP 条目  {0}'}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Payload.OriginMd5, StringFormat='旧版 MD5  {0}'}"/>
                    <TextBlock Text="{Binding Payload.ResultMd5, StringFormat='目标 MD5  {0}'}"/>
                    <TextBlock Text="{Binding Payload.DeltaMd5, StringFormat='差分 MD5  {0}'}"/>
                  </StackPanel>
                </StackPanel>
              </TextBlock.ToolTip>
            </TextBlock>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                    AutomationProperties.Name="调整资源树宽度">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="Divider" Width="1" Background="#E4E7EC" HorizontalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Divider" Property="Background" Value="#8DA8CF"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Divider" Property="Background" Value="#2563EB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>
      <local:HexDiffView Grid.Column="2" Grid.RowSpan="2" x:Name="ResourceHexView"/>
    </Grid>
    <Border Grid.Row="1" x:Name="CatalogView" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="6" Visibility="Collapsed">
          <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="刷新官方目录" Click="RefreshCatalog"/>
                <Button x:Name="OpenPatchButton" Content="打开本地 ZIP…" Click="OpenPatch" ToolTip="可同时选择同一次更新的多个分卷"/>
                <Button x:Name="DownloadButton" Content="下载并查看" Click="DownloadPatch" IsEnabled="False"/>
                <Button x:Name="ViewCatalogPatchButton" Content="打开容器级清单" Style="{StaticResource Primary}" Click="OpenCatalogPatch" IsEnabled="False" Margin="0"/>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="CatalogTitle" Text="官方国服 V3 补丁" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="CatalogInfo" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <TextBox Grid.Row="1" x:Name="CatalogSearch" Style="{StaticResource SearchTextBox}" Tag="搜索数据版本或游戏版本…" Width="470" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="搜索数据版本或游戏构建版本" TextChanged="FilterCatalog"/>
            <Border Grid.Row="2" Style="{StaticResource RoundedPreviewFrame}">
              <DataGrid x:Name="CatalogGrid" BorderThickness="0" SelectionChanged="CatalogSelected">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="" Binding="{Binding Package.Badge}" Width="55"/>
                  <DataGridTextColumn Header="来源版本" Binding="{Binding Package.From}" Width="94"/>
                  <DataGridTextColumn Header="目标版本" Binding="{Binding Package.To}" Width="94"/>
                  <DataGridTextColumn Header="游戏构建 / 版本" Binding="{Binding Package.VersionView}" Width="*" MinWidth="225"/>
                  <DataGridTextColumn Header="分卷" Binding="{Binding Package.Files.Count}" Width="58"/>
                  <DataGridTextColumn Header="总大小" Binding="{Binding Package.SizeLabel}" Width="104"/>
                  <DataGridTextColumn Header="可访问性" Binding="{Binding Package.AccessLabel}" Width="100"/>
                  <DataGridTextColumn Header="本地分卷" Binding="{Binding LocalStatus}" Width="94"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <ScrollViewer Grid.Row="3" MaxHeight="144" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="CatalogDetail" Text="选择一条更新查看 ZIP 分卷。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
            </ScrollViewer>
          </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="DiffView" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <CheckBox x:Name="DiffLinked" IsChecked="True" Content="关联显示" Margin="0,0,12,0" VerticalAlignment="Center" Click="ToggleDiffRelations" ToolTip="按字段定义显示引用表内容；取消勾选查看 Raw。差异判断和筛选仍以原始值为准。"/>
          <Button x:Name="ClearFiltersButton" Content="清除筛选" Click="ClearFilters" Visibility="Collapsed" Padding="8,3"/>
          <TextBlock Text="− 旧值" Foreground="#CF222E" VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock Text="+ 新值" Foreground="#116329" VerticalAlignment="Center"/>
          <CheckBox x:Name="ChangedColumnsOnly" Content="只看变化列" IsChecked="True" VerticalAlignment="Center" Margin="14,0" Click="ColumnsChanged"/>
          <Button x:Name="FitDiffColumnsButton" Content="重置列宽" Click="ResetDiffColumnSizing" IsEnabled="False" Padding="10,4"
                  ToolTip="按当前视图的表头和单元格最大宽度重置"/>
          <Button x:Name="RetryMatchButton" Content="重新匹配" Padding="10,4" Margin="0" Click="RetryMatch" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock x:Name="DiffSummary" Text="加载补丁 ZIP 后自动匹配 CHS 历史版本" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="DiffMatchError" Foreground="#CF222E" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="140" MaxWidth="520"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
        <DockPanel>
          <TextBox x:Name="SheetSearch" Style="{StaticResource SearchTextBox}" Tag="搜索变化的表…" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="搜索变化表" TextChanged="FilterSheets"/>
          <TreeView x:Name="SheetsList" Style="{StaticResource CompactPathTree}" SelectedItemChanged="SheetSelected" PreviewMouseRightButtonDown="CopyDiffTableName" PreviewMouseLeftButtonDown="ClickDiffTable"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource CompactPathTreeItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Label}" Margin="0,1" TextTrimming="CharacterEllipsis">
                  <TextBlock.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <StackPanel>
                        <TextBlock Text="{Binding FullPath}"/>
                        <TextBlock Text="{Binding Payload.State}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </ToolTip>
                  </TextBlock.ToolTip>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                          <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#E4E7EC" ShowsPreview="True" ToolTip="拖动调整表目录宽度"/>
        <Grid Grid.Column="2">
          <Border Style="{StaticResource RoundedPreviewFrame}" Padding="0">
            <DataGrid x:Name="DiffGrid" BorderThickness="0" CanUserSortColumns="False" CanUserReorderColumns="False" RowHeight="32" SelectionUnit="Cell" FrozenColumnCount="1"
                      RowHeaderWidth="0" RowHeaderStyle="{StaticResource HiddenTableRowHeader}"
                      PreviewMouseLeftButtonUp="InspectCellClick" PreviewMouseRightButtonUp="OpenDiffCellActions" PreviewKeyDown="InspectCellKeyDown"
                      ScrollViewer.ScrollChanged="DiffGridScrolled" LostMouseCapture="DiffGridLostMouseCapture"/>
          </Border>
          <TextBlock x:Name="DiffEmptyMessage" Visibility="Collapsed" Margin="12,46,12,0" VerticalAlignment="Top"
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" IsHitTestVisible="False"/>

        </Grid>
      </Grid>
      <Popup x:Name="CellDetailsPopup" Placement="Bottom" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True">
        <Border x:Name="CellDetailsContent" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="8" Width="640" PreviewKeyDown="DismissCellDetailsOnEscape">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <local:DiffValueView x:Name="OldCell" IsReadOnly="True" Height="224" Padding="8,5" VerticalScrollBarVisibility="Auto" Background="#FFEBE9" BorderBrush="#FFCECB" Foreground="#82071E" ToolTip="完整旧值；字符串支持字符高亮，可选择并复制"/>
            <local:DiffValueView Grid.Column="2" x:Name="NewCell" IsReadOnly="True" Height="224" Padding="8,5" VerticalScrollBarVisibility="Auto" Background="#DAFBE1" BorderBrush="#ACEBBE" Foreground="#116329" ToolTip="完整新值；字符串支持字符高亮，可选择并复制"/>
          </Grid>
        </Border>
      </Popup>
      <Popup x:Name="ColumnFilterPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Width="300">
          <StackPanel>
            <TextBlock x:Name="ColumnFilterTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="ColumnFilterInput" Style="{StaticResource SearchTextBox}" Tag="输入关键词，Enter 应用" KeyDown="ColumnFilterKeyDown"/>
            <TextBlock Text="匹配旧值或新值；多个列条件同时满足。" Foreground="#667085" FontSize="11" Margin="0,6"/>
            <StackPanel Orientation="Horizontal"><Button Content="应用" Click="ApplyColumnFilter"/><Button Content="清除此列" Click="ClearColumnFilter"/></StackPanel>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
    <local:SqPackBrowser Grid.Row="1" x:Name="SqPackView" Visibility="Collapsed"/>
    <Border Grid.Row="1" x:Name="SettingsView" Visibility="Collapsed" Background="{StaticResource WorkspaceSurface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="9" Padding="20" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="游戏目录" FontWeight="SemiBold"/>
        <DockPanel Margin="0,8,0,4">
          <Button x:Name="ChooseGameDirectoryButton" DockPanel.Dock="Right" Content="浏览…" Click="ChooseGameDirectory" Margin="8,0,0,0"/>
          <TextBox x:Name="GameDirectorySetting" IsReadOnly="True" Tag="尚未选择游戏目录"/>
        </DockPanel>
        <TextBlock Text="选择游戏安装目录、game 或 sqpack 目录。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock Text="补丁目录" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <DockPanel Margin="0,8,0,4">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
            <Button x:Name="ChoosePatchDirectoryButton" Content="浏览…" Click="ChoosePatchDirectory"/>
            <Button x:Name="ResetPatchDirectoryButton" Content="恢复默认" Click="ResetPatchDirectory" Margin="0"/>
          </StackPanel>
          <TextBox x:Name="PatchDirectorySetting" IsReadOnly="True"/>
        </DockPanel>
        <TextBlock Text="用于查找已有补丁和选择 ZIP。新下载的补丁仍放在工作区的 tmp/patches。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <Button x:Name="LoadLatestPatchButton" Content="打开目录中最新补丁" Click="LoadLatestPatchFromSettings" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock Text="Godbert 动作解码库" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <DockPanel Margin="0,8,0,4">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
            <Button Content="选择 DLL…" Click="ChooseGodbertLibrary"/>
            <Button Content="保存" Click="SaveGodbertLibrary" Margin="0"/>
          </StackPanel>
          <TextBox x:Name="GodbertLibrarySetting" Tag="Godbert 安装目录或 hkAnimationInterop.dll 路径"/>
        </DockPanel>
        <TextBlock Text="用于读取支持的怪物 PAP 动作。可填写 Godbert 安装目录、Godbert\hkAnimationInterop.dll 的完整路径，或任意包含该 DLL 的目录。清空后保存可移除配置。"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="GodbertLibraryStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2" x:Name="MainStatusBar" Margin="0,8,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Padding="12,3" Visibility="Collapsed" Click="Cancel"/><ProgressBar x:Name="Progress" Width="110" Height="4" DockPanel.Dock="Right" Margin="12,0,12,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock x:Name="Status" Text="就绪" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
  </Grid>
  <Border x:Name="ToastSurface" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
          Margin="16,0,16,14" MaxWidth="640" Padding="12,8" CornerRadius="6" BorderThickness="1"
          BorderBrush="{StaticResource Border}" Background="{StaticResource ShellRaised}" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Border>
</Grid>
</DockPanel>
</Window>
