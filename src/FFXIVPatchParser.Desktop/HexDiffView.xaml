<UserControl x:Class="FFXIVPatchParser.Desktop.HexDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,6">
      <WrapPanel>
        <ComboBox x:Name="HexMode" Width="140" Margin="0,0,8,0" IsEnabled="False" SelectedIndex="0"
                  SelectionChanged="ChangeMode" AutomationProperties.Name="Hex 显示方式">
          <ComboBoxItem Content="VCDIFF 字节" ToolTip="补丁 ZIP 中的差分指令和数据。左侧数字是差分文件内的偏移。"/>
          <ComboBoxItem Content="目标文件字节" ToolTip="通过 MD5 校验的本地新版文件。左侧数字是目标文件内的偏移。"/>
          <ComboBoxItem Content="旧 / 新字节对照" ToolTip="比较旧版和新版在相同文件偏移的实际字节。红色为旧字节，绿色为新字节。"/>
        </ComboBox>
        <Button x:Name="ChooseOriginButton" Content="选择旧版目录…" Click="ChooseOrigin" IsEnabled="False"
                ToolTip="选择旧版安装目录、game 或 sqpack，按旧版和目标版的文件偏移对照。"/>
        <Button x:Name="CancelReadButton" Content="取消" Click="CancelRead" Visibility="Collapsed"/>
        <Button x:Name="RetryReadButton" Content="重新读取" Click="RetryRead" Visibility="Collapsed"/>
      </WrapPanel>
      <DockPanel Margin="0,6,0,0">
        <WrapPanel DockPanel.Dock="Right">
          <TextBox x:Name="OffsetInput" Width="114" FontFamily="Consolas" Tag="Hex 偏移" KeyDown="OffsetKeyDown"
                   AutomationProperties.Name="Hex 偏移"/>
          <Button x:Name="JumpToHexOffset" Content="跳转" Click="JumpToOffset" IsEnabled="False" Margin="4,0,0,0"/>
        </WrapPanel>
        <DockPanel Margin="0,0,12,0">
          <WrapPanel DockPanel.Dock="Right">
            <Button x:Name="PreviousHexRange" Content="‹" Click="PreviousRange" IsEnabled="False" Margin="4,0"
                    ToolTip="上一个目标写入区间" AutomationProperties.Name="上一个目标写入区间"/>
            <Button x:Name="NextHexRange" Content="›" Click="NextRange" IsEnabled="False" Margin="0"
                    ToolTip="下一个目标写入区间" AutomationProperties.Name="下一个目标写入区间"/>
          </WrapPanel>
          <ComboBox x:Name="WriteRanges" IsEnabled="False" SelectionChanged="SelectRange"
                    DisplayMemberPath="Label" AutomationProperties.Name="目标写入区间" ToolTip="选择目标文件的写入区间"
                    ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ComboBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
          </ComboBox>
        </DockPanel>
      </DockPanel>
    </StackPanel>
    <RichTextBox Grid.Row="1" x:Name="HexBytes" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White"
                 BorderBrush="#E4E7EC" BorderThickness="1" Padding="10,8" AutomationProperties.Name="十六进制字节">
      <FlowDocument PagePadding="0" ColumnWidth="900"/>
    </RichTextBox>
    <TextBlock Grid.Row="2" x:Name="ReadStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</UserControl>
