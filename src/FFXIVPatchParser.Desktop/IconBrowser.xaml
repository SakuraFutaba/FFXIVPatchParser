<UserControl x:Class="FFXIVPatchParser.Desktop.IconBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="IconNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Width" Value="62"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <EventSetter Event="KeyDown" Handler="NumberKeyDown"/>
      <EventSetter Event="LostKeyboardFocus" Handler="NumberFocusLost"/>
    </Style>
    <Style x:Key="IconTileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <Border x:Name="Highlight" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Highlight" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Highlight" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ContextMenuService.ShowOnDisabled" Value="True"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
      <EventSetter Event="Click" Handler="OpenIcon"/>
      <EventSetter Event="ToolTipOpening" Handler="OpenHoverPreview"/>
      <EventSetter Event="ToolTipClosing" Handler="CloseHoverPreview"/>
    </Style>
    <DataTemplate x:Key="IconTileTemplate">
        <Grid>
          <TextBlock Text="{Binding Indicator}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
          <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                 IsHitTestVisible="False"/>
        </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto" SharedSizeGroup="BrowserFooter"/>
    </Grid.RowDefinitions>
    <WrapPanel x:Name="Filters" Margin="0,0,0,5" IsEnabled="False">
      <StackPanel Orientation="Horizontal" Margin="0,0,18,5" ToolTip="显示大于或等于起始 ID、且小于结束 ID 的图标">
        <TextBlock Text="图标 ID" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBox x:Name="StartRange" Text="0" Style="{StaticResource IconNumber}" AutomationProperties.Name="起始图标 ID，包含"/>
        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="EndRange" Text="300000" Style="{StaticResource IconNumber}" AutomationProperties.Name="结束图标 ID，未包含"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,18,5" ToolTip="设置缩略图显示范围的宽和高，图标会保持原始比例">
        <TextBlock Text="缩略图" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBox x:Name="IconWidth" Text="64" Style="{StaticResource IconNumber}" Width="46" AutomationProperties.Name="缩略图宽度"/>
        <TextBlock Text="×" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        <TextBox x:Name="IconHeight" Text="64" Style="{StaticResource IconNumber}" Width="46" AutomationProperties.Name="缩略图高度"/>
      </StackPanel>
    </WrapPanel>
      <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource Border}"
              Background="{StaticResource WorkspaceSurface}" CornerRadius="6" ClipToBounds="True">
        <Grid>
          <ScrollViewer x:Name="IconScroll" Style="{StaticResource OverlayDetailScroll}" CanContentScroll="False"
                        ScrollChanged="IconScrollChanged" PreviewMouseLeftButtonDown="StartGridDrag"
                        PreviewMouseMove="DragGrid" PreviewMouseLeftButtonUp="StopGridDrag"
                        LostMouseCapture="GridCaptureLost">
            <Canvas x:Name="IconSurface" Background="Transparent" Height="0"/>
          </ScrollViewer>
          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
            <TextBlock x:Name="EmptyMessage" Text="连接本地游戏后即可浏览图标" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="RetryCatalogButton" Content="重试" Click="RetryCatalog" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>
    <TextBlock x:Name="CountLabel" Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/>
  </Grid>
</UserControl>
